# OMEGA Infinity – Beispielkonfiguration. Kopieren nach .env bzw. in die Umgebung des Prozesses übernehmen.
# Niemals echte Geheimnisse in das Repository einchecken.

OMEGA_PORT=4317
OMEGA_HOST=127.0.0.1
OMEGA_DATA_DIR=./data
OMEGA_BACKUP_DIR=./backups
# Unabhängiger Speicherort für Backup-Kopien (anderer Datenträger / eingebundener Cloud-Speicher):
# OMEGA_BACKUP_EXTERNAL_DIR=/mnt/backup/omega
# Verschlüsselung der Sicherungen (lange Passphrase, sicher verwahren – ohne sie sind Backups nicht lesbar):
# OMEGA_BACKUP_PASSPHRASE=
OMEGA_BACKUP_INTERVAL_MINUTES=15
# Schlüssel für gespeicherte Geheimnisse (z. B. `openssl rand -base64 32`):
# OMEGA_SECRET_KEY=
# OMEGA_PUBLIC_URL=https://omega.example.com
# OMEGA_TRUST_PROXY=false

# GitHub (nur lesend): Fine-grained PAT mit Metadata: Read + Contents: Read
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_POLL_MINUTES=30

# Optionale KI-Funktionen (Ideengenerierung, Fragen an OMI):
# ANTHROPIC_API_KEY=
# OMEGA_CLAUDE_MODEL=claude-opus-5-5
