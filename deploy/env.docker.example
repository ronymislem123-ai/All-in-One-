# Vorlage für Docker-Betrieb:  cp deploy/env.docker.example .env && chmod 600 .env
# Werte mit <…> ersetzen. Diese Datei niemals einchecken (.env steht in .gitignore).
# Enthält ein Wert ein $-Zeichen, ihn in einfache Anführungszeichen setzen:  KEY='wert$mit$dollar'

# ── Pflicht für den Dauerbetrieb ────────────────────────────────────────
# Schlüssel für gespeicherte Geheimnisse (GitHub-Token usw.):  openssl rand -base64 32
OMEGA_SECRET_KEY=<openssl rand -base64 32>
# Verschlüsselt alle Sicherungen. Gut verwahren – ohne sie sind die Backups nicht lesbar!
OMEGA_BACKUP_PASSPHRASE=<lange zufällige Passphrase, z. B. openssl rand -base64 48>

# ── HTTPS (Profil "https") ──────────────────────────────────────────────
# Domain, unter der OMEGA erreichbar ist (DNS muss auf diesen Server zeigen):
# OMEGA_DOMAIN=omega.example.com
# OMEGA_PUBLIC_URL=https://omega.example.com
# Hinter Caddy die echte Client-IP für Rate-Limits verwenden:
# OMEGA_TRUST_PROXY=true
# Zertifikat: deine E-Mail-Adresse → Let's Encrypt (öffentliche Domain)
#             internal               → eigene Caddy-CA (Heimnetz/NAS, Standard)
# CADDY_TLS=du@example.com

# ── Unabhängige Backup-Kopie (deploy/docker-compose.external-backup.yml) ─
# OMEGA_EXTERNAL_BACKUP_PATH=/mnt/nas/omega-backups

# ── Optional ────────────────────────────────────────────────────────────
# Fester Einrichtungscode statt zufälligem (nach der Einrichtung wieder entfernen):
# OMEGA_SETUP_CODE=
# OMEGA_BACKUP_INTERVAL_MINUTES=15
# GitHub (nur lesend: Metadata + Contents: Read). Alternativ in der Oberfläche speichern.
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_POLL_MINUTES=30
# KI-Funktionen (Ideengenerierung, Fragen an OMI):
# ANTHROPIC_API_KEY=
# Anderer lokaler Port (Standard 4317):
# OMEGA_LOCAL_PORT=4317
